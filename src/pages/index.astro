---
import { getCollection } from 'astro:content';
const fmt = (d) => d.toISOString().slice(0, 10);
const codeHtml = [
  "<span class=\"ln\">17</span> <span class=\"ann\">@SpringBootApplication</span>",
  "<span class=\"ln\">18</span> <span class=\"kw\">public class</span> <span class=\"cls\">BlogApplication</span> {",
  "<span class=\"ln\">19</span>   <span class=\"kw\">public static void</span> <span class=\"fn\">main</span>(<span class=\"cls\">String</span>[] args) {",
  "<span class=\"ln\">20</span>     <span class=\"cls\">SpringApplication</span>.<span class=\"fn\">run</span>(<span class=\"cls\">BlogApplication</span>.<span class=\"kw\">class</span>, args);",
  "<span class=\"ln\">21</span>   }",
  "<span class=\"ln\">22</span> }",
  "<span class=\"ln\">23</span>",
  "<span class=\"ln\">24</span> <span class=\"ann\">@RestController</span>",
  "<span class=\"ln\">25</span> <span class=\"ann\">@RequiredArgsConstructor</span>",
  "<span class=\"ln\">26</span> <span class=\"kw\">class</span> <span class=\"cls\">PostController</span> {",
  "<span class=\"ln\">27</span>   <span class=\"kw\">private final</span> <span class=\"cls\">PostService</span> service;",
  "<span class=\"ln\">28</span>",
  "<span class=\"ln\">29</span>   <span class=\"ann\">@GetMapping</span>(<span class=\"str\">\"/posts/&#123;id&#125;\"</span>)",
  "<span class=\"ln\">30</span>   <span class=\"cls\">ResponseEntity</span>&lt;<span class=\"cls\">Post</span>&gt; <span class=\"fn\">get</span>(<span class=\"ann\">@PathVariable</span> <span class=\"cls\">Long</span> id) {",
  "<span class=\"ln\">31</span>     <span class=\"kw\">return</span> <span class=\"cls\">ResponseEntity</span>.<span class=\"fn\">ok</span>(service.<span class=\"fn\">find</span>(id));  <span class=\"cmt\">// 200 OK</span>",
  "<span class=\"ln\">32</span>   }",
  "<span class=\"ln\">33</span> }",
].join(String.fromCharCode(10));
// 배너는 화면에 고정(fixed)되어 움직이지 않고, 스크롤하면 제자리에서 천천히 사라진다.
// 글은 담는 상자 없이 배경 위에 그대로 나타난다 — 패널/테두리/그림자 없음.
// 기본 배경 테마: 종이(paper)
const byDate = (a, b) => b.data.date.valueOf() - a.data.date.valueOf();
const live = (e) => !e.data.draft;
const readMin = (e) => Math.max(1, Math.round((e.body?.length ?? 0) / 500));
const posts = (await getCollection('posts')).filter(live).sort(byDate).slice(0, 5)
  .map((e) => ({ t: e.data.title, d: fmt(e.data.date), tags: e.data.tags ?? [],
                 m: readMin(e), s: e.data.summary ?? '', href: `/posts/${e.id}/` }));
const logs = (await getCollection('log')).filter(live).sort(byDate).slice(0, 4)
  .map((e) => ({ t: e.data.title, d: fmt(e.data.date) }));

---

<html lang="ko" data-theme="paper" data-banner="code"><head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Taehyeon's blog</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/quiple/galmuri/dist/galmuri.css" />
</head>
<body>
  <!-- 배너: 고정. 스크롤해도 움직이지 않고 천천히 사라진다 -->
  <div class="hero" aria-hidden="true">
    <div class="hero-art"></div>
    <div class="screen"><pre class="code" set:html={codeHtml}></pre></div>
  </div>
  <div class="hero-mid">
    <h1><span id="type"></span><span class="caret" id="c1" aria-hidden="true"></span></h1>
    <p id="sub"><span id="type2"></span><span class="caret" id="c2" aria-hidden="true"></span></p>
    <span class="cue"><svg viewBox="0 0 16 16"><path d="m4 6 4 4 4-4" /></svg></span>
  </div>

  <header class="nav" id="nav">
    <div class="nav-in">
      <nav class="menu">
        <a class="on" href="/">Home</a><a href="/posts">Posts</a><a href="/log">Log</a><a href="#">About</a>
      </nav>
    </div>
  </header>

  <!-- 전환 구간: 이만큼 스크롤하는 동안 배너가 사라지고 글이 떠오른다 -->
  <div class="gap"></div>

  <!-- 글: 상자 없이 배경 위에 -->
  <div class="content" id="content">
    <aside class="side">
      <img class="pfp" src="/art/avatar.jpg" width="60" height="60" alt="정태현" />
      <div>
        <h2>정태현</h2>
        <p class="role">AI Backend Engineer</p>
        <div class="links"><a href="https://github.com/badul13">GitHub</a><span class="dotsep"></span><a href="mailto:badul13@users.noreply.github.com">Mail</a></div>
      </div>
    </aside>

    <main>
      <section>
        <h3><i class="mk"></i>Posts</h3>
        <ul class="list">
          {posts.map((p) => (
            <li><a href={p.href}>
              <span class="i-mk"></span>
              <span class="t">{p.t}</span>
              <span class="s">{p.s}</span>
              <span class="li-meta">
                <time>{p.d}</time><span class="tags">{p.tags.join(' / ')}</span><span class="min">{p.m} min</span>
              </span>
            </a></li>
          ))}
        </ul>
          {posts.length === 0 && <p class="empty">아직 글이 없습니다.</p>}
        <a class="more" href="#">모든 글 <svg viewBox="0 0 16 16"><path d="m6 4 4 4-4 4"/></svg></a>
      </section>

      <section>
        <h3><i class="mk dim"></i>Log</h3>
        <ul class="list log">
          {logs.map((l) => (
            <li><a href="/log">
              <span class="i-mk"></span>
              <span class="t">{l.t}</span>
              <span class="li-meta"><time>{l.d}</time></span>
            </a></li>
          ))}
        </ul>
          {logs.length === 0 && <p class="empty">아직 기록이 없습니다.</p>}
      </section>

      <footer class="foot">
        <span class="dots" aria-hidden="true"></span>© 2026 정태현 · Taehyeon Jeong
      </footer>
    </main>
  </div>


  <script>
    // 히어로 문구: 제목을 찍고 → 그다음 부제를 찍는다
    (() => {
      const t1 = document.getElementById('type'), t2 = document.getElementById('type2');
      const c1 = document.getElementById('c1'), c2 = document.getElementById('c2');
      const TITLE = "Taehyeon's blog";
      const SUB = 'Started badul13 in 0.42 seconds';
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) {
        t1.textContent = TITLE; t2.textContent = SUB;
        c1.style.opacity = '0'; return;
      }
      c2.style.opacity = '0';
      const type = (el, text, min, jit, done) => {
        let i = 0;
        const tick = () => {
          el.textContent = text.slice(0, ++i);
          if (i < text.length) setTimeout(tick, min + Math.random() * jit);
          else done && done();
        };
        tick();
      };
      setTimeout(() => type(t1, TITLE, 88, 62, () => {
        setTimeout(() => {
          c1.style.animation = 'none'; c1.style.opacity = '0';  // 자리는 유지, 보이지만 않게
          c2.style.opacity = '';
          type(t2, SUB, 34, 26);
        }, 340);
      }), 420);
    })();

    const root = document.documentElement;
    const nav = document.getElementById('nav');

    // 스크롤 진행도 p(0~1). 전환 구간은 한 화면 전체를 쓴다 — 급하게 바뀌지 않도록.
    let raf = 0;
    const onScroll = () => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        const vh = window.innerHeight, y = window.scrollY;
        // 전환 구간은 0.95화면을 기본으로 하되, 글이 적어 스크롤 여유가 짧으면
        // 문서 길이에 맞춰 줄인다. 그래야 끝까지 내렸을 때 배너가 완전히 사라진다.
        const room = (document.scrollingElement.scrollHeight - vh) * 0.88;
        const range = Math.max(1, Math.min(vh * 0.95, room));
        const p = Math.min(1, Math.max(0, y / range));
        // 문구가 사라진 뒤부터 글이 올라온다 — 배너 흐려짐과는 겹치되 글자끼리는 안 겹치게
        const q = Math.min(1, Math.max(0, (y - vh * 0.34) / (vh * 0.6)));
        root.style.setProperty('--p', p.toFixed(4));
        root.style.setProperty('--pe', (p * p * (3 - 2 * p)).toFixed(4)); // 이징
        root.style.setProperty('--q', q.toFixed(4));
        nav.classList.toggle('show', y > vh * 0.8);
        // 프로필: 전환이 70% 넘게 진행되면 팝업, 배너로 되돌아가면 사라짐
        const side = document.querySelector('.side');
        if (side) side.classList.toggle('in', p > 0.7);
      });
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    onScroll();

  </script>

  <style is:global>
    :root { --p:0; --pe:0; --q:0; --herobg:#2A1C17; }
    :root[data-theme='paper'] {
      --bg:#F3EEE9; --hair:rgba(59,42,36,.07);
      --text:#3B2A24; --muted:#7A6559; --faint:#A79385; --accent:#8A5A3B;
    }
    :root[data-theme='ink'] {
      --bg:#14100E; --hair:rgba(240,234,231,.07);
      --text:#F0EAE7; --muted:#B9ABA5; --faint:#7C6D67; --accent:#D7A86E;
    }
    :root[data-theme='espresso'] {
      --bg:#2A1C17; --hair:rgba(243,235,231,.08);
      --text:#F3EBE7; --muted:#C6B3AA; --faint:#8E7468; --accent:#E0B384;
    }
    :root[data-theme='forest'] {
      --bg:#141A14; --hair:rgba(237,240,234,.07);
      --text:#EDF0EA; --muted:#A9B3A3; --faint:#6F7A6B; --accent:#D7A86E;
    }
    :root[data-theme='slate'] {
      --bg:#16181A; --hair:rgba(236,238,240,.07);
      --text:#ECEEF0; --muted:#A8AEB4; --faint:#6E767D; --accent:#C98F5E;
    }

    * { box-sizing:border-box; }
    body { margin:0; background:var(--bg); color:var(--text);
      font-family:Pretendard,-apple-system,'Segoe UI','Apple SD Gothic Neo','Malgun Gothic',system-ui,sans-serif;
      font-size:15.5px; line-height:1.75; transition:background .5s, color .5s; }
    svg { fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }

    /* ── 배너: 제자리에서 사라진다 (움직이지 않음) ───────────── */
    .hero { position:fixed; inset:0; z-index:0; pointer-events:none;
      opacity:calc(1 - var(--pe)); }
    /* 페이드가 화면 전체에 균일하게 걸리지 않게, 아래쪽부터 먼저 사라지도록
       배경색 커튼을 아래에서 위로 올린다 */
    .hero::after { content:''; position:absolute; inset:0; pointer-events:none;
      background:linear-gradient(to top,
        var(--bg) calc(var(--pe) * 160% - 60%),
        transparent calc(var(--pe) * 160%)); }
    .hero-art { position:absolute; inset:0; background-color:var(--herobg);
      filter:blur(calc(var(--p) * 7px)); transform:scale(calc(1 + var(--p) * .035));
      transition:background-image .5s; }
    /* 배너 = 화면 전체가 모니터 */
    .screen { position:absolute; inset:0; display:none; overflow:hidden;
      padding:7vh 5vw 0; color:#BCAAA4;
      font-family:'GalmuriMono11','Galmuri11',ui-monospace,monospace; font-size:22px; line-height:2;
      -webkit-font-smoothing:none; }
    :root[data-banner='code'] .screen { display:block; }
    .code { margin:0; white-space:pre; opacity:.62; }
    .ln  { color:#4E342E; } .kw { color:#D7A86E; } .ann { color:#E0B384; }
    .cls { color:#BCAAA4; } .fn { color:#8D6E63; } .str { color:#7D8471; } .cmt { color:#5D4037; }
    .screen::after { content:''; position:absolute; inset:0; pointer-events:none;
      background:repeating-linear-gradient(0deg, rgba(0,0,0,.10) 0 1px, transparent 1px 4px); }
    .hero-mid { position:fixed; inset:0; z-index:1; display:grid; place-content:center;
      justify-items:start; text-align:left; pointer-events:none;
      color:var(--bg);                     /* 블로그 배경색과 같은 값 (#F3EEE9) */
      opacity:calc(1 - var(--pe) * 2.6); }
    .hero-mid h1 { position:relative; margin:0; font-size:clamp(34px, 6vw, 68px); line-height:1.1;
      font-weight:800; letter-spacing:-0.04em; display:inline-flex; align-items:center; gap:4px; }
    .caret { display:inline-block; width:.055em; height:.82em; background:var(--accent);
      animation:blink 1.05s steps(1) infinite; }
    .caret.done { animation:blink 1.05s steps(1) 3; opacity:0; }
    #c2 { animation-duration:2.1s; }   /* 부제 커서는 주기 두 배 */
    @keyframes blink { 50% { opacity:0; } }
    .hero-mid p { position:relative; margin:18px 0 0; font-size:14px; letter-spacing:.02em; color:#E0B384;
      font-family:'JetBrains Mono',ui-monospace,'Cascadia Mono',Consolas,monospace;
      display:inline-flex; align-items:center; gap:2px; }

    .cue { position:absolute; left:50%; bottom:34px; transform:translateX(-50%);
      color:var(--faint); animation:bob 2.6s ease-in-out infinite; }
    .cue svg { width:18px; height:18px; display:block; }
    @keyframes bob { 0%,100%{transform:translate(-50%,0)} 50%{transform:translate(-50%,6px)} }

    /* 전환 구간 */
    .gap { height:100svh; }

    /* ── 네비: 전환이 끝날 무렵 조용히 들어온다 ──────────────── */
    .nav { position:fixed; top:0; left:0; right:0; z-index:30;
      opacity:0; pointer-events:none; transition:opacity .7s ease;
      background:linear-gradient(180deg,
        color-mix(in oklab, var(--bg) 92%, transparent) 0%,
        color-mix(in oklab, var(--bg) 70%, transparent) 62%,
        transparent 100%);
      -webkit-backdrop-filter:blur(10px); backdrop-filter:blur(10px);
      -webkit-mask-image:linear-gradient(180deg, #000 62%, transparent 100%);
      mask-image:linear-gradient(180deg, #000 62%, transparent 100%); }
    .nav.show { opacity:1; pointer-events:auto; }
    .nav-in { max-width:1180px; margin:0 auto; height:68px; padding:0 32px;
      display:flex; align-items:center; justify-content:flex-end; gap:24px; }
    .brand { color:var(--text); text-decoration:none; font-weight:600; font-size:15px; letter-spacing:-0.01em; }
    .menu { display:flex; gap:24px; }
    .menu a { color:var(--muted); text-decoration:none; font-size:13.5px; transition:color .18s; }
    .menu a:hover { color:var(--text); }
    .menu a.on { color:var(--accent); }

    /* ── 글: 상자 없음. 스크롤에 연동된 페이드를 걸지 않는다 ── */
    .content { position:relative; z-index:2; max-width:1180px; margin:0 auto;
      padding:18vh 32px 140px; display:grid; grid-template-columns:248px 1fr; gap:72px;
      align-items:start; }

    .side { position:sticky; top:104px; display:flex; flex-direction:column; gap:16px;
      opacity:0; transform:translateY(12px) scale(.94); transform-origin:50% 0;
      transition:opacity .34s ease, transform .44s cubic-bezier(.2,.9,.2,1.25); }
    .side.in { opacity:1; transform:none; }
    .pfp { width:60px; height:60px; border-radius:50%; object-fit:cover; display:block; }
    .mark { width:30px; height:auto; fill:var(--accent); stroke:none; shape-rendering:crispEdges; }
    .side h2 { margin:0; font-size:18px; font-weight:620; letter-spacing:-0.01em; }
    .role { margin:7px 0 16px; font-size:13.5px; line-height:1.6; color:var(--muted); }
    .role span { color:var(--faint); }
    .links { display:flex; align-items:center; gap:10px; font-size:13px; }
    .links a { color:var(--muted); text-decoration:none; transition:color .18s; }
    .links a:hover { color:var(--accent); }
    .dotsep { width:3px; height:3px; background:var(--faint); }

    main { min-width:0; }
    main section { margin-bottom:72px; }
    h3 { display:flex; align-items:center; gap:9px; margin:0 0 18px;
      font-size:11.5px; letter-spacing:.26em; text-transform:uppercase; color:var(--faint); font-weight:600; }
    .mk { width:5px; height:5px; background:var(--accent); }
    .mk.dim { background:var(--faint); }

    .list { list-style:none; margin:0; padding:0; }
    .list a { position:relative; display:block; padding:24px 0 25px 20px; text-decoration:none;
      color:var(--text); transition:padding-left .22s; }
    .list li + li a { box-shadow:0 -1px 0 var(--hair); }
    .list a:hover { padding-left:24px; }
    .i-mk { position:absolute; left:0; top:34px; width:5px; height:5px; background:var(--accent);
      opacity:0; transform:translateX(-4px); transition:opacity .22s, transform .22s; }
    .list a:hover .i-mk { opacity:1; transform:none; }
    .t { display:block; font-size:21px; font-weight:580; letter-spacing:-0.012em; transition:color .2s; }
    .list a:hover .t { color:var(--accent); }
    .s { display:block; margin-top:6px; font-size:14.5px; color:var(--muted); }
    .li-meta { display:flex; align-items:center; gap:14px; margin-top:9px; font-size:12px; color:var(--faint); }
    .li-meta time { font-variant-numeric:tabular-nums; }
    .tags { color:var(--muted); }
    .min { margin-left:auto; }
    .log .t { font-size:17px; font-weight:520; color:var(--muted); }
    .log a:hover .t { color:var(--text); }

    .empty { margin:10px 0 0; font-size:14px; color:var(--faint); }
    .more { display:inline-flex; align-items:center; gap:6px; margin-top:18px;
      font-size:13px; color:var(--muted); text-decoration:none; transition:color .18s, gap .18s; }
    .more svg { width:13px; height:13px; }
    .more:hover { color:var(--accent); gap:10px; }

    .foot { display:flex; align-items:center; gap:12px; font-size:12.5px; color:var(--faint); }
    .dots { width:44px; height:5px;
      background-image:radial-gradient(currentColor 1px, transparent 1.4px);
      background-size:5px 5px; opacity:.55; }


    @media (max-width:820px) {
      .content { grid-template-columns:1fr; gap:34px; padding:14vh 22px 90px; }
      .t { font-size:19px; }
      .side { position:static; flex-direction:row; align-items:center; gap:16px; }
      .pfp { flex:none; }
      .role { margin:4px 0 8px; }
      .menu { gap:16px; }
    }
    @media (prefers-reduced-motion:reduce) { .cue { animation:none; } }
  </style>
</body></html>
