---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

const entries = (await getCollection('work'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const rendered = await Promise.all(
  entries.map(async (e) => ({ entry: e, Content: (await render(e)).Content })),
);
const fmt = (d) => d.toISOString().slice(0, 10);
---

<Base title="Work · badul13">
  <div class="page-head">
    <h1>Work</h1>
    <a class="edit-link" data-auth href="/write/?new=work" hidden>작성</a>
  </div>
  <div style="margin-top:32px">
    {rendered.map(({ entry, Content }) => (
      <div class="log-entry">
        <time class="muted small" datetime={fmt(entry.data.date)}>{fmt(entry.data.date)}</time>
        <a class="edit-link" data-auth href={`/write/?edit=work/${entry.id}`} hidden>수정</a>
        <h3>{entry.data.title}</h3>
        <div class="log-body"><Content /></div>
      </div>
    ))}
    {rendered.length === 0 && <p class="muted small">아직 기록 없음</p>}
  </div>
</Base>
