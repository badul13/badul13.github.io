---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

// 일기는 글이 짧아서 개별 페이지 없이 한 장에 타임라인으로 쭉 쌓는다
const logs = (await getCollection('log'))
  .filter((l) => !l.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const rendered = await Promise.all(
  logs.map(async (l) => ({ entry: l, Content: (await render(l)).Content })),
);
const fmt = (d) => d.toISOString().slice(0, 10);
---

<Base title="Log · badul13">
  <h1>Log</h1>
  {/* TODO: 섹션 설명 한 줄 */}
  <div style="margin-top:32px">
    {rendered.map(({ entry, Content }) => (
      <div class="log-entry">
        <time class="muted small" datetime={fmt(entry.data.date)}>{fmt(entry.data.date)}</time>
        <h3>{entry.data.title}</h3>
        <div class="log-body"><Content /></div>
      </div>
    ))}
  </div>
</Base>
